  bindings:
  - optionId: legs
    artworkKeyword: GrowLegs
    sourceDescription: Double jump. Legs occupy one slot.
    shortTitle: Grow Legs
    regrowthTitle: Regrow Legs
    shortDescription: 'Double jump.

      Uses 1 slot.'
  - optionId: arms
    artworkKeyword: GrowArms
    sourceDescription: Arms and sword share one slot. Basic attack becomes sword.
    shortTitle: Grow Arms
    regrowthTitle: Regrow Arms
    shortDescription: 'Arms and sword.

      Slash attack.

      Uses 1 slot.'
  - optionId: tail
    artworkKeyword: GrowTail
    sourceDescription: Dash. Tail occupies one slot.
    shortTitle: Grow Tail
    regrowthTitle: Regrow Tail
    shortDescription: 'Gain a dash.

      Uses 1 slot.'
  - optionId: flame-tail
    artworkKeyword: GrowFlameTail
    sourceDescription: 'Q / RMB: slow flame orb, 8 damage every 0.2s while touching;
      lasts 2s, cooldown 8s. Replaces normal tail / Dash.'
    shortTitle: Grow Flame Tail
    regrowthTitle: Regrow Flame Tail
    shortDescription: 'Fire orb (Q / RMB).

      Replaces tail / dash.

      Uses
      1 slot.'
  - optionId: heal
    artworkKeyword: RestoreHP
    sourceDescription: Restore 25 HP. Can be chosen at full health.
    shortTitle: Restore HP
    regrowthTitle: Restore HP
    shortDescription: 'Restore 25 HP.

      Full HP: no healing.'
  - optionId: max-health
    artworkKeyword: MaxHPUp
    sourceDescription: Maximum HP +15. Current HP stays unchanged.
    shortTitle: Max HP Up
    regrowthTitle: Max HP Up
    shortDescription: 'Max HP +15.

      No healing.'
  - optionId: attack
    artworkKeyword: AttackUp
    sourceDescription: All attacks +10 damage per hit, including each fire tick.
      No slot required.
    shortTitle: Attack Up
    regrowthTitle: Attack Up
    shortDescription: 'All attacks +10.

      Includes fire ticks.'
